# ==================================
# Office Attendance & Identity System
# ==================================

# Application
APP_NAME=Office Attendance & Identity System
APP_VERSION=2.0.0
DEBUG=true

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_DB_PASSWORD@localhost:5432/identity_verification
DATABASE_SYNC_URL=postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/identity_verification
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_DB_PASSWORD
POSTGRES_DB=identity_verification

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT — generate a real secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=YOUR_SECRET_KEY_HERE
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# File storage
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# ML paths
FAISS_INDEX_DIR=data/faiss_indices
MODEL_CACHE_DIR=data/models

# Biometric thresholds
FACE_MATCH_THRESHOLD=0.6
VOICE_MATCH_THRESHOLD=0.25

# Office settings
OFFICE_GRACE_MINUTES=15
OVERTIME_THRESHOLD_MINUTES=30
